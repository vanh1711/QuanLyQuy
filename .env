# Chế độ lưu trữ dữ liệu: 'local_api' (Laragon MySQL) | 'supabase' (Cloud DB) | 'demo_local'
VITE_STORAGE_MODE=local_api

# Địa chỉ API Laragon (hoặc http://quanlyquy.test/api nếu dùng virtual host của Laragon)
VITE_API_BASE_URL=http://localhost/QuanLyQuy/api

# Cấu hình Supabase (Điền khi deploy lên Vercel)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Tiêu đề ứng dụng
VITE_APP_TITLE=Quản Lý Quỹ Nhóm & Đóng Quỹ Thông Minh
