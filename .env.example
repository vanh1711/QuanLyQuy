# =======================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG (ENVIRONMENT VARIABLES)
# =======================================================

# 1. Chế độ lưu trữ: 'local_api' (Laragon) hoặc 'supabase' (Cloud DB khi deploy Vercel)
VITE_STORAGE_MODE=supabase

# 2. Cấu hình Supabase (Lấy từ Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. Địa chỉ Local API (chỉ dùng khi chạy qua Laragon PHP)
VITE_API_BASE_URL=http://localhost/QuanLyQuy/api

# 4. Tiêu đề Website
VITE_APP_TITLE=Quản Lý Quỹ Nhóm & Đóng Quỹ Tự Động VietQR
